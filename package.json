{
  "name": "irpwm",
  "productName": "IRPWM",
  "version": "2.0.0",
  "description": "Indian Railways Permanent Way Manual — 2024 reprint incorporating ACS up to No. 16",
  "author": "IRPWM Digital Edition",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.0",
    "@capacitor/core": "7.6.9"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.6.9",
    "electron": "39.8.10",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "in.irpwm.handbook",
    "productName": "IRPWM",
    "copyright": "Indian Railways Permanent Way Manual, 2024 reprint",
    "files": ["electron/**", "www/**", "build/icon.png", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IRPWM - Permanent Way Manual",
      "uninstallDisplayName": "IRPWM - Indian Railways Permanent Way Manual",
      "artifactName": "IRPWM-Windows-Setup.${ext}"
    },
    "portable": { "artifactName": "IRPWM-Windows-Portable.${ext}" }
  }
}
